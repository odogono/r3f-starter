{
  "name": "vite-react-starter",
  "private": false,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "bun ./index.html",
    "build": "bun run build.ts",
    "prepare": "bun run scripts/setup-git-hooks.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "eslint --cache src",
    "lint:fix": "eslint --fix src",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "preview": "bun ./dist/index.html",
    "unused": "knip",
    "coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test": "bun test"
  },
  "dependencies": {
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "clsx": "^2.1.1",
    "jotai": "^2.18.0",
    "mitt": "^3.0.1",
    "odgn-ts-helpers": "^0.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "^3.3.0",
    "@react-three/eslint-plugin": "^0.1.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.0.2",
    "knip": "^5.85.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "bun-plugin-tailwind": "^0.1.2"
  }
}